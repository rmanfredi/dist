?MAKE:d_procctl: Trylink cat
?MAKE:	-pick add $@ %<
?S:d_procctl:
?S:	This variable conditionally defines HAS_PROCCTL if procctl() is
?S:	available to control process behaviour and that of its future children.
?S:.
?C:HAS_PROCCTL:
?C:	This symbol, if defined, indicates that the procctl routine is
?C:	available to control process behaviour and that of its future'
?C:	children.
?C:.
?H:#$d_procctl HAS_PROCCTL	/**/
?H:.
?LINT:set d_procctl
: see if procctl exists
$cat >try.c <<EOC
#include <sys/procctl.h>
int main(void)
{
	static int ret, number = 0;
	ret |= procctl(P_PID, 0, PROC_REAP_ACQUIRE, &number);
	return ret ? 0 : 1;
}
EOC
cyn=procctl
set d_procctl
eval $trylink

